{
  "name": "pulse-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customizable Spotify player with JSON themes and JS add-ons (Android via Capacitor, PC later)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:patch": "node scripts/patch-android.mjs",
    "pc:start": "vite build && electron .",
    "pc:build": "vite build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.pulse.player",
    "productName": "Pulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Pulse-${version}-portable.exe"
    }
  }
}
